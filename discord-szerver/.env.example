# Másold ezt a fájlt ".env" néven, és töltsd ki!
# A bot tokenje a Discord Developer Portalról (Bot fül -> Reset Token).
DISCORD_TOKEN=ide_jon_a_bot_tokened

# A szerver azonosítója. Ha a bot csak 1 szerveren van, ezt üresen hagyhatod.
# Discord -> Beállítások -> Haladó -> Fejlesztői mód BE, majd jobb klikk a
# szerver nevére -> "Szerverazonosító másolása".
GUILD_ID=
