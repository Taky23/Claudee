# Másold le ezt a fájlt .env néven, és töltsd ki!
DISCORD_TOKEN=ide_jon_a_bot_tokenje

# Opcionális: a szervered azonosítója. Ha megadod, a parancsok azonnal megjelennek
# ott (különben a globális frissülés pár percig is eltarthat).
GUILD_ID=

# Opcionális: hova mentse az adatokat
DB_PATH=data/bot.db

# --- Szerverbot (python -m szerverbot) ---
SZERVERBOT_TOKEN=
SZERVERBOT_DB=data/szerverbot.db
